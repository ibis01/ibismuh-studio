@@ -265,6 +265,25 @@ test.describe("S123 — motion graphics end-to-end", () => {
     //    never rides video.error for an engine-lane video (S69 lane
     //    attribution) — poll hasVideo only, attach the last error text.
     test.setTimeout(240_000);
